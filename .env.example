# Copy these variables into your local shell or secret manager.
# Do not commit real SMTP credentials or a populated .env file.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_FROM=your-sender@example.com
SMTP_USERNAME=YOUR_MAILTRAP_USERNAME
SMTP_PASSWORD=YOUR_MAILTRAP_PASSWORD
SMTP_STARTTLS=true
REPORT_EMAIL_TO=customer@example.com
